# Copie para .env.local e preencha com os dados do projeto Supabase (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Endereço público do site, usado nos links de e-mail e de compartilhamento.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente no servidor (Vercel → Environment Variables, sem NEXT_PUBLIC). Usada no envio da fila de e-mails.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# E-mail transacional (Resend). Sem estas variáveis os avisos ficam na fila, sem envio.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM="Trivagas <nao-responda@seu-dominio.com.br>"

# Protege a rota de envio agendado (/api/notificacoes); a Vercel envia este valor no cron.
CRON_SECRET=troque-por-um-valor-aleatorio-longo

# Anti-robô (Cloudflare Turnstile) nos formulários públicos de cadastro e denúncia.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxx

# Leitura automática do PDF do currículo (Claude). Sem a chave, o recurso fica oculto.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# WhatsApp (Cloud API da Meta). Os modelos de mensagem listados em src/lib/notifications/whatsapp.ts
# precisam estar aprovados no WhatsApp Business Manager. Sem estas variáveis, as mensagens ficam na fila.
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
