# Copie para .env.local e preencha com os dados do projeto Supabase (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Endereço público do site, usado nos links de e-mail e de compartilhamento.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente no servidor (Vercel → Environment Variables, sem NEXT_PUBLIC). Usada no envio da fila de e-mails.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# E-mail transacional (Resend). Sem estas variáveis os avisos ficam na fila, sem envio.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM="Trivagas <nao-responda@seu-dominio.com.br>"

# Protege a rota de envio agendado (/api/notificacoes); a Vercel envia este valor no cron.
CRON_SECRET=troque-por-um-valor-aleatorio-longo
